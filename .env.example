# Application and PostgreSQL
MEDIGUARD_PERSISTENCE_BACKEND=postgres
MEDIGUARD_DATABASE_URL=postgresql+psycopg://mediguard:<DB_PASSWORD>@localhost:5432/mediguard
MEDIGUARD_AUTH_SECRET_KEY=<AT_LEAST_32_RANDOM_CHARACTERS>
MEDIGUARD_DEFAULT_AUDITOR_PASSWORD=<AT_LEAST_8_CHARACTERS>

# Review Advisor is fail-closed and disabled until all values are configured.
MEDIGUARD_REVIEW_ADVISOR_ENABLED=false
MEDIGUARD_REVIEW_ADVISOR_PROVIDER=deepseek
MEDIGUARD_REVIEW_ADVISOR_BASE_URL=https://api.deepseek.com
MEDIGUARD_REVIEW_ADVISOR_MODEL=deepseek-v4-flash
MEDIGUARD_REVIEW_ADVISOR_DEEPSEEK_API_KEY=<ROTATED_DEEPSEEK_API_KEY>
MEDIGUARD_REVIEW_ADVISOR_THINKING_ENABLED=true
MEDIGUARD_REVIEW_ADVISOR_REASONING_EFFORT=low
MEDIGUARD_REVIEW_ADVISOR_TIMEOUT_SECONDS=90
MEDIGUARD_REVIEW_ADVISOR_MAX_MODEL_CALLS=5
MEDIGUARD_REVIEW_ADVISOR_MAX_TOOL_CALLS=12
MEDIGUARD_REVIEW_ADVISOR_MAX_PLANNING_ROUNDS=3
MEDIGUARD_REVIEW_ADVISOR_MAX_CONCURRENCY=2
# Keep true by default. Set false only for local bring-up when strict citation/numeric checks block debugging.
MEDIGUARD_REVIEW_ADVISOR_STRICT_LOCAL_VALIDATION=true

# Case Agent is separate from Review Advisor and uses DeepSeek by default.
MEDIGUARD_CASE_AGENT_ENABLED=false
MEDIGUARD_CASE_AGENT_PROVIDER=deepseek
MEDIGUARD_CASE_AGENT_BASE_URL=https://api.deepseek.com
MEDIGUARD_CASE_AGENT_MODEL=deepseek-v4-flash
MEDIGUARD_CASE_AGENT_DEEPSEEK_API_KEY=<ROTATED_DEEPSEEK_API_KEY>
MEDIGUARD_CASE_AGENT_THINKING_ENABLED=false
MEDIGUARD_CASE_AGENT_REASONING_EFFORT=low
MEDIGUARD_CASE_AGENT_TIMEOUT_SECONDS=90
MEDIGUARD_CASE_AGENT_SEMANTIC_TIMEOUT_SECONDS=12
MEDIGUARD_CASE_AGENT_PLANNER_TIMEOUT_SECONDS=15
MEDIGUARD_CASE_AGENT_ANSWER_TIMEOUT_SECONDS=30
MEDIGUARD_CASE_AGENT_SEMANTIC_MAX_TOKENS=384
MEDIGUARD_CASE_AGENT_PLANNER_MAX_TOKENS=768
MEDIGUARD_CASE_AGENT_ANSWER_MAX_TOKENS=1536
MEDIGUARD_CASE_AGENT_MAX_CONCURRENCY=2
MEDIGUARD_CASE_AGENT_MAX_TOOL_CALLS=5
MEDIGUARD_CASE_AGENT_FAST_MODE_ENABLED=true

# Governed long-term memory. PostgreSQL is the truth ledger; Mem0/Graph sync runs off-path.
MEDIGUARD_CASE_MEMORY_ENABLED=true
MEDIGUARD_CASE_MEMORY_WORKER_ENABLED=true
MEDIGUARD_CASE_MEMORY_WORKER_POLL_SECONDS=2
MEDIGUARD_CASE_MEMORY_RECONCILIATION_SECONDS=86400
MEDIGUARD_CASE_MEMORY_CONSOLIDATION_SECONDS=3600
MEDIGUARD_MEM0_ENABLED=true
MEDIGUARD_MEM0_LLM_MODEL=deepseek-v4-flash
MEDIGUARD_MEM0_LLM_BASE_URL=https://api.deepseek.com
MEDIGUARD_MEM0_EMBEDDING_MODEL=BAAI/bge-m3
MEDIGUARD_MEM0_GRAPH_BACKEND=sql

# Policy RAG vector backend. Default remains local FAISS.
# Built-in FAISS defaults point to the versioned runtime index with Shanghai drug price reference data:
# - src/backend/policy_corpus/rag_ready/indexes/faiss_bge_m3_flat_ip_with_shanghai_drug_price_20260820_full
# - src/backend/policy_corpus/rag_ready/nodes/policy_nodes_with_shanghai_drug_price_20260820_full.jsonl
# Leave path overrides empty to use the built-in default. Set both values explicitly to switch or roll back.
# The hybrid strategy uses the production Policy RAG strict-v3 group-aware profile:
# metadata filters + FAISS/Qdrant bge-m3 + BM25 + RRF, conservative split only for explicit complex queries.
# Set MEDIGUARD_POLICY_RAG_VECTOR_BACKEND=qdrant only after the Qdrant collection is built.
MEDIGUARD_POLICY_RAG_RETRIEVAL_STRATEGY=hybrid
MEDIGUARD_POLICY_RAG_VECTOR_BACKEND=faiss
# v1 uses the current production snapshot; switch to v2 only after building metadata v2 artifacts.
MEDIGUARD_POLICY_RAG_INDEX_VERSION=v1
MEDIGUARD_POLICY_RAG_RUNTIME_RERANKER_ENABLED=false
MEDIGUARD_POLICY_RAG_INDEX_DIR=
MEDIGUARD_POLICY_RAG_NODES_PATH=
MEDIGUARD_POLICY_RAG_INDEX_PATH=
MEDIGUARD_POLICY_RAG_INDEX_NODE_IDS_PATH=
MEDIGUARD_POLICY_RAG_INDEX_MANIFEST_PATH=
MEDIGUARD_POLICY_RAG_QDRANT_URL=http://127.0.0.1:6333
MEDIGUARD_POLICY_RAG_QDRANT_PATH=
MEDIGUARD_POLICY_RAG_QDRANT_COLLECTION=mediguard_policy_bge_m3
MEDIGUARD_POLICY_RAG_QDRANT_API_KEY=

# Expert Analysis is an isolated L3 sub-agent runtime.
MEDIGUARD_EXPERT_ANALYSIS_PROVIDER=deepseek
MEDIGUARD_EXPERT_ANALYSIS_BASE_URL=https://api.deepseek.com
MEDIGUARD_EXPERT_ANALYSIS_MODEL=deepseek-v4-flash
MEDIGUARD_EXPERT_ANALYSIS_DEEPSEEK_API_KEY=<ROTATED_DEEPSEEK_API_KEY>
MEDIGUARD_EXPERT_ANALYSIS_THINKING_ENABLED=true
MEDIGUARD_EXPERT_ANALYSIS_REASONING_EFFORT=low
MEDIGUARD_EXPERT_ANALYSIS_TIMEOUT_SECONDS=90
# One no-thinking synthesis call is allowed only for complex, multi-need policy answers.
MEDIGUARD_POLICY_BATCH_SYNTHESIS_ENABLED=true
